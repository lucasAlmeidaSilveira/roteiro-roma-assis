# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel (Settings → Environment Variables).
# Nunca faça commit de .env.local.
# A aba Intenções é aberta a quem tem o link (sem código de acesso) — decisão D-15 em docs/DECISIONS.md.

# --- Leitura da planilha de respostas do Google Forms (conta de serviço do Google Cloud) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a chave inteira, com as quebras de linha como \n (do jeito que vem no JSON).
GOOGLE_PRIVATE_KEY=
# O trecho entre /d/ e /edit no link da planilha.
INTENCOES_SHEET_ID=
# Opcional: intervalo lido (padrão A1:Z2000 da primeira aba).
INTENCOES_RANGE=

# --- Só para testes automatizados (nunca na Vercel) ---
# INTENCOES_FIXTURE=1 faz o servidor ler tests/fixtures/intencoes.json em vez do Google.
INTENCOES_FIXTURE=
