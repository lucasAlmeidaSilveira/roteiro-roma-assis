{
  "name": "roteiro-roma-assis",
  "version": "0.1.0",
  "private": true,
  "description": "Roteiro dia a dia de Roma e Assis (14–24/11/2026) — Next.js, pronto para Vercel.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:legacy": "playwright test -c playwright.legacy.config.ts",
    "parity": "node scripts/check-parity.mjs",
    "checklist": "node scripts/acceptance-checklist.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run parity",
    "check:all": "npm run check && npm run build && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "google-auth-library": "11.3.4",
    "jose": "6.2.17",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,md}": "prettier --write"
  }
}
