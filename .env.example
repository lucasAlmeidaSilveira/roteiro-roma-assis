# Nenhuma variável é obrigatória (D-15 e D-16 em docs/DECISIONS.md): a aba Intenções é aberta e lê a planilha
# de respostas pelo export em CSV, usando o link que está em src/data/intentions.json (sheetUrl).
# Se precisar de alguma, copie para .env.local (desenvolvimento) e cadastre o mesmo nome na Vercel.

# Opcional: gid da aba de respostas, se NÃO for a primeira aba da planilha (número depois de "gid=" no link).
INTENCOES_GID=

# Só para testes automatizados (nunca na Vercel): lê tests/fixtures/intencoes.json em vez da planilha.
INTENCOES_FIXTURE=
